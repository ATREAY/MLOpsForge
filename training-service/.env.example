# SSH connection to the Slurm cluster's login node (the compute plane).
# See docs/ENVIRONMENT.md — this is the one place credentials to the HPC
# cluster live. Generate a dedicated keypair for this service; don't reuse
# your personal one.
SLURM_SSH_HOST=slurm-login00.cse.iith.ac.in
SLURM_SSH_PORT=22
SLURM_SSH_USER=cs25mtech14023
SLURM_SSH_KEY_PATH=/run/secrets/mlopsforge_training_service_key

# Where this repo is checked out on the Slurm cluster's filesystem, and the
# Python interpreter there with torch/numpy/pandas/scikit-learn installed
# (a plugin's requirements.txt should be installed into this same env).
SLURM_REPO_PATH=/u/student/2025/cs25mtech14023/MLSys_Projects/MLOpsForge
SLURM_PYTHON_BIN=/u/student/2025/cs25mtech14023/.conda/envs/env/bin/python3

SLURM_DEFAULT_PARTITION=cse-gpu-all
SLURM_POLL_INTERVAL_SECONDS=15

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

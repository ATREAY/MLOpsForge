# Copied into each service's environment by docker-compose.yml. Copy this file
# to infra/.env and fill in real values before running `docker compose up`.

POSTGRES_USER=mlopsforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlopsforge

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

JWT_SECRET_KEY=change-me-in-production

# Path (on the Docker host) to the dedicated SSH private key training-service
# uses to reach the Slurm cluster — see training-service/README.md. Mounted
# read-only into the training-service container.
SLURM_SSH_KEY_HOST_PATH=~/.ssh/mlopsforge_training_service
SLURM_SSH_HOST=slurm-login00.cse.iith.ac.in
SLURM_SSH_USER=cs25mtech14023
SLURM_REPO_PATH=/u/student/2025/cs25mtech14023/MLSys_Projects/MLOpsForge
SLURM_PYTHON_BIN=/u/student/2025/cs25mtech14023/.conda/envs/env/bin/python3
SLURM_DEFAULT_PARTITION=cse-gpu-all
